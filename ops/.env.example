# Vorlage: nach ops/.env kopieren und Werte anpassen.
#   cp .env.example .env

# Thema (Kanal) für ntfy-Alarme. Muss **unratbar** sein – wer das Thema kennt,
# kann mitlesen (der Dienst läuft nur im LAN, ohne eigene Anmeldung).
# Beispiel erzeugen:  openssl rand -hex 8
NTFY_TOPIC=ut-alerts

# Basis-URL für Links in den Benachrichtigungen (Adresse der Maschine im LAN)
NTFY_BASE_URL=http://10.1.9.53:8086

# Zugangsschutz für Dozzle: "simple" (Anmeldung aus dozzle-users.yml) oder
# leer lassen, um ihn abzuschalten (dann nur im LAN erreichbar halten!).
DOZZLE_AUTH_PROVIDER=simple
