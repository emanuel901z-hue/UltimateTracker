# Vorlage: nach server/.env kopieren und Werte setzen.
#   cp .env.example .env
# Tokens erzeugen (z. B.):  openssl rand -hex 24

# --- Audio-Bridge ---
# Token für den Tracker (Uplink-Upload, Sync/Poll, Downlink-Download)
DEVICE_TOKEN=change-me-device-token
# Token für die Eltern-Web-UI / -API (Skripte, Erstinstallation, Rückfallweg)
PARENT_TOKEN=change-me-parent-token
# Anmeldung der Eltern-UI: Der erste Administrator wird beim Start aus diesen
# Werten angelegt (nur, solange noch kein Benutzer existiert). Passwort:
# mindestens 10 Zeichen, nicht in der Sperrliste. Danach weitere Zugänge über
# die UI/API anlegen (POST /api/v1/auth/users).
PARENT_USER=admin
PARENT_PASSWORD=
# Optional: Token, den Traccar beim Event-Webhook mitschickt.
# Leer = Webhook ohne Token (nur intern im Docker-Netz erreichbar halten).
TRACCAR_WEBHOOK_TOKEN=
# Standarddauer des Suchmodus in Minuten
SEARCH_MODE_MINUTES=30

# --- Bridge-Verhalten ---
# Benachrichtigungen bei neuen Nachrichten / Suchmodus / niedrigem Akku.
# Kommaseparierte Apprise-URLs, z. B.:
#   ntfy://ntfy.sh/mein-thema   telegram://token/chatid   mailto://user:pass@gmail.com
#   json://echo-server:9999/ut  (zum Testen mit scripts/dev-echo-server.py)
APPRISE_URLS=
# Kontakt für Web-Push (VAPID-Claims); die Schlüssel erzeugt die Bridge selbst
VAPID_SUBJECT=mailto:admin@example.org
# Aufbewahrung der Audionachrichten in Tagen (0 = nie löschen)
RETENTION_DAYS=30
# Karte in der Eltern-UI (Leaflet, selbst gehostet): Kachelquelle.
# Standard ist OpenStreetMap – dabei sieht der Kachelserver, welche Kartenausschnitte
# abgerufen werden. Für "keine externen Aufrufe" einen eigenen Kachelserver eintragen.
MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap-Mitwirkende
# Maximale Uploadgröße pro Audiodatei in MB
MAX_UPLOAD_MB=2
# Server-getriebenes Poll-Intervall (Normalbetrieb / Suchmodus), in Sekunden
POLL_INTERVAL_S=900
SEARCH_POLL_INTERVAL_S=60

# --- Datenbank (Traccar) ---
# Standard: PostgreSQL (produktivtauglich, siehe docs/optimizations.md A10).
POSTGRES_USER=traccar
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_URL=jdbc:postgresql://postgres:5432/traccar
DATABASE_USER=traccar
DATABASE_PASSWORD=change-me-postgres-password
#
# H2-Fallback (einfacher, aber nicht produktionsempfohlen):
#   POSTGRES_* leer lassen, postgres-Dienst stoppen und stattdessen setzen:
#   DATABASE_DRIVER=org.h2.Driver
#   DATABASE_URL=jdbc:h2:./data/database
#   DATABASE_USER=sa
#   DATABASE_PASSWORD=

# --- TLS-Reverse-Proxy (Profil "tls", Caddy) ---
# Hostnamen für die drei Dienste (DNS/hosts muss darauf zeigen).
# Achtung: nicht leer lassen – Caddy-Defaults greifen nur bei fehlender Variable.
SITE_AUDIO=audio.localhost
SITE_TRACCAR=traccar.localhost
SITE_FINDMY=findmy.localhost
# Apple-Find-My-Oberfläche (macless-haystack, Profil findmy)
SITE_APPLE=apple.localhost
# Schnellzugriff über IP/Rechnernamen (z. B. https://192.168.1.50/ → Eltern-UI).
# Für LAN-Zugriff vom Handy auf die Host-IP setzen (siehe docs/deployment.md 8.3).
SITE_LAN=localhost
# Zertifikat: "internal" = lokale CA (Default, für LAN)
#             oder E-Mail-Adresse → Let's Encrypt (echte Domain, Ports 80/443)
TLS_ARG=internal
# Single Sign-on: Cookie-Domain für die Dienste hinter Caddy. Leer = automatisch
# (bei *.localhost wird "localhost" gesetzt). Für eigene Subdomains z. B.
# SESSION_COOKIE_DOMAIN=.example.org
SESSION_COOKIE_DOMAIN=
# Automatische Traccar-Anmeldung: Zugangsdaten des Traccar-Kontos (siehe
# ADMIN-ZUGANG.txt). Damit entfällt das zweite Login beim Öffnen von Traccar.
TRACCAR_SSO_EMAIL=
TRACCAR_SSO_PASSWORD=

# --- Find My (optionales Compose-Profil "findmy") ---
# Token für den Find-My-Ingest der Bridge.
# Leer = offen (dann Endpunkt nicht nach außen exponieren!).
FINDMY_TOKEN=
# Find-My-Positionen zusätzlich an Traccar weiterreichen (leer = aus).
# Jeder Beacon erscheint dort als eigenes Gerät (ID = beacon_id, bereinigt).
TRACCAR_FORWARD_URL=http://traccar:5055
# API-Token des Google-Microservices (Minimal-Variante, Port 5500)
GOOGLE_FINDMY_TOKEN=change-me-google-token

# --- Apple Find My (Profil "findmy", automatische Bridge) ---
# Kommaseparierte, Base64-kodierte Private Keys deiner OpenHaystack-/DIY-Beacons
# (erzeugt z. B. mit macless-haystack generate_keys.py).
APPLE_BEACON_KEYS=
# Abfrageintervall in Sekunden (Default 3600; < 1800 riskant fürs Apple-Konto)
APPLE_POLL_INTERVAL=3600
# Ziel der Apple-Bridge. Standard: unser OsmAnd-kompatibler Ingest – so fließen
# Apple-Positionen in die Sensor-Fusion und Traccar bekommt eine Position je Kind.
# (Historisch zeigte das direkt auf Traccar; nur zum Zurückschalten ändern.)
APPLE_BRIDGE_TARGET=http://audio-bridge:8085/api/v1/findmy/osmand

# --- Google-Find-Hub-WebUI (empfohlener Weg, jetzt ohne eigenen Port) ---
# Die WebUI ist nur über Caddy erreichbar (findmy.localhost) und liegt damit
# hinter der Anmeldung der Eltern-UI – ein zweiter Login entfällt.
# Nur wenn du die WebUI bewusst direkt veröffentlichst, hier Zugangsdaten setzen:
WEBUI_USER=
WEBUI_PASSWORD=
# Verschlüsselung der Google-Tokens at rest (beliebiger String).
# Achtung: Verlust/Änderung = erneutes Google-Login nötig.
WEBUI_SECRETS_KEY=
# Zeitzone für UI/Logs
TZ=Europe/Berlin

# --- SIM-/SMS-Anbieter (anbieterneutral, docs/sim-providers.md) ---
# nce         = 1NCE (Standard; nutzt die 1NCE_*-Zugangsdaten unten)
# whereversim = wherever SIM (GraphQL/AppSync, Token-Header)
# generic     = beliebiger HTTP-API-Anbieter über eine JSON-Konfiguration
#               (Vorlagen: server/sim-providers/example-*.json)
# none        = SMS-Funktionen deaktiviert
SIM_PROVIDER=nce
# Nur für "generic": Pfad zur JSON-Konfiguration im Container
# (server/sim-providers/ ist als /etc/ut/providers gemountet)
SIM_PROVIDER_CONFIG=
# Echtzeit-SMS abonnieren (nur Anbieter mit WebSocket-Support, z. B. whereversim)
SMS_SUBSCRIBE=

# wherever SIM (SIM_PROVIDER=whereversim)
WHEREVERSIM_API_TOKEN=
# Optional: eigene Endpunkte (Default: Produktions-API)
# WHEREVERSIM_API_URL=https://graphql.api.whereversim.com/graphql
# WHEREVERSIM_WS_URL=wss://graphql.api.whereversim.com/graphql/realtime

# Vorlagen für weitere Anbieter (SIM_PROVIDER=generic):
#   EMNIFY_APPLICATION_TOKEN=      (example-emnify-generic.json)
#   ONOMONDO_API_KEY=              (example-onomondo-generic.json)
#   TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN=   (example-twilio-supersim-generic.json)

# 1NCE API Admission
# Wir bieten RESTful-APIs für eine nahtlose Geräteverwaltung an. 
# Um darauf zuzugreifen, generieren Sie API-Zugangsdaten im Bereich unten. 
# Die Kommunikation mit der API erfolgt über HTTP(S)-Anfragen mit JSON-Body-Content vom Content-Type "application/json" 
# und Autorisierungstyp oauth2 (OAuth2, application), der für jeden API-Aufruf erforderlich ist.
#
# WICHTIG: Diese Datei (.env.example) ist die Vorlage. Die laufende Instanz liest
# die Werte aus server/.env – und die wird beim WSL-Sync absichtlich NICHT
# übertragen (Secrets bleiben lokal). Zugangsdaten also direkt in der WSL-Datei
# ~/UltimateTracker/server/.env pflegen:
#   wsl -d UltimateTracker -- nano ~/UltimateTracker/server/.env
1NCE_API_CLIENTID=
1NCE_API_CLIENTSECRET=
# Optional: Absenderadresse für MT-SMS (laut 1NCE beliebig, wird nicht genutzt)
NCE_SMS_SOURCE=12345
# Optional: andere API-Basis (Default: https://api.1nce.com/management-api)
NCE_API_BASE=
