# Vorlage: nach server/.env kopieren und Werte setzen.
#   cp .env.example .env
# Tokens erzeugen (z. B.):  openssl rand -hex 24

# --- Audio-Bridge ---
# Token für den Tracker (Uplink-Upload, Poll, Downlink-Download)
DEVICE_TOKEN=change-me-device-token
# Token für die Eltern-Web-UI / -API
PARENT_TOKEN=change-me-parent-token
# Optional: Token, den Traccar beim Event-Webhook mitschickt.
# Leer = Webhook ohne Token (nur intern im Docker-Netz erreichbar halten).
TRACCAR_WEBHOOK_TOKEN=
# Standarddauer des Suchmodus in Minuten
SEARCH_MODE_MINUTES=30

# --- Find My (optionales Compose-Profil "findmy") ---
# Token für den Find-My-Ingest der Bridge.
# Leer = offen (dann Endpunkt nicht nach außen exponieren!). Erst setzen, wenn
# das Push-Format des Google-Microservices mit Headern verifiziert ist.
FINDMY_TOKEN=
# Find-My-Positionen zusätzlich an Traccar weiterreichen (leer = aus).
# Jeder Beacon erscheint dort als eigenes Gerät (ID = beacon_id).
TRACCAR_FORWARD_URL=http://traccar:5055
# API-Token des Google-Microservices (Client-Auth an Port 5500)
GOOGLE_FINDMY_TOKEN=change-me-google-token
