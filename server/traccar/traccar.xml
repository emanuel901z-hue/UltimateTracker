<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <!-- Documentation: https://www.traccar.org/configuration-file/ -->

    <!-- Datenbank: Pflichteinträge – ohne sie startet Traccar nicht.
         H2-Datei liegt im Docker-Volume (traccar-data -> /opt/traccar/data). -->
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password' />

    <!-- Unbekannte Geräte automatisch registrieren (Prototyp; im Betrieb ggf. abschalten). -->
    <entry key='database.registerUnknown'>true</entry>

    <!-- Traccar-Ereignisse (Geofence, Alarm, Status) an die Audio-Bridge weiterleiten. -->
    <entry key='event.forward.enable'>true</entry>
    <entry key='event.forward.url'>http://audio-bridge:8085/api/v1/traccar/events</entry>

    <!-- Ereignis-Handler explizit aktivieren (sonst werden manche Typen nicht erzeugt). -->
    <entry key='event.statusHandler'>true</entry>
    <entry key='event.alertHandler'>true</entry>
    <entry key='event.geofenceHandler'>true</entry>
    <entry key='event.motionHandler'>true</entry>
    <entry key='event.ignitionHandler'>true</entry>
    <entry key='event.maintenanceHandler'>true</entry>

    <!-- Falls in server/.env ein TRACCAR_WEBHOOK_TOKEN gesetzt ist, hier denselben
         Wert als Header eintragen (Kommentar entfernen):
    <entry key='event.forward.header'>X-Auth-Token: DEIN_WEBHOOK_TOKEN</entry>
    -->

</properties>
