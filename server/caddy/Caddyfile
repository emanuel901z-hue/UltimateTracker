# Caddyfile – TLS-Reverse-Proxy für den UltimateTracker-Stack.
#
# Betrieb:
#   docker compose --profile tls up -d
#
# Konfiguration über server/.env (leer = Default aus docker-compose.yml):
#   SITE_AUDIO   = Hostname der Eltern-UI/API      (Default: audio.localhost)
#   SITE_TRACCAR = Hostname der Traccar-Web-UI     (Default: traccar.localhost)
#   SITE_FINDMY  = Hostname der Google-WebUI       (Default: findmy.localhost)
#   TLS_ARG      = "internal" (lokales Zertifikat, Default)
#                  oder eine E-Mail-Adresse → Let's Encrypt (echte Domain, Ports 80/443)
#
# LAN-Betrieb (Default): Caddy erzeugt eine eigene CA. Einmalig das Root-Zertifikat
# exportieren und auf den Geräten (Handy der Eltern!) installieren:
#   docker compose --profile tls exec caddy cat /data/caddy/pki/authorities/local/root.crt > caddy-root.crt
# Hostnamen müssen auf den Server zeigen (Router-DNS oder hosts-Datei).
#
# Internet-Betrieb: echte Domains in SITE_* eintragen, TLS_ARG=du@example.org,
# Ports 80/443 freigeben – Caddy holt die Zertifikate automatisch.

# Global: Für Verbindungen OHNE SNI (Browser senden bei IP-Adressen kein SNI)
# verwendet Caddy dieses Zertifikat – nötig für https://<host-ip>/
{
	default_sni {$SITE_LAN:localhost}
}

# ---------------------------------------------------------------------------
# Freundliche Fehlerseite, wenn ein Dienst (noch) nicht antwortet – statt der
# nackten Browser-Meldung „Diese Seite funktioniert nicht / HTTP ERROR 502".
# Wird per `import` in die Dienst-Blöcke eingebunden.
# ---------------------------------------------------------------------------
(ut_unavailable_page) {
	handle_errors {
		@unavailable expression {err.status_code} in [502, 503, 504]
		handle @unavailable {
			header Content-Type "text/html; charset=utf-8"
			respond "<!doctype html><html lang='de'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>Dienst nicht erreichbar – UltimateTracker</title></head><body style='font:1rem/1.6 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;max-width:36rem;margin:2rem auto;padding:0 1rem;color:#12171c;background:#f4f6f8'><h1 style='font-size:1.25rem'>Dieser Dienst ist gerade nicht erreichbar</h1><p>Die Oberfläche antwortet nicht. Häufigste Ursachen: der Dienst startet noch, oder die Apple-Anmeldung ist noch nicht abgeschlossen (einmaliger 2FA-Code per SMS).</p><p>Status prüfen und einrichten: <a style='color:#0b57c2' href='https://{$SITE_AUDIO:audio.localhost}/'>Eltern-UI</a> → Tab „Geräte“ → „Apple Find My einrichten“.</p></body></html>" 502
		}
	}
}

{$SITE_AUDIO:audio.localhost} {
	tls {$TLS_ARG:internal}
	encode zstd gzip
	reverse_proxy audio-bridge:8085
}

# ---------------------------------------------------------------------------
# Single Sign-on: Traccar und die Find-My-Oberflächen prüfen die Anmeldung der
# Eltern-UI (Cookie "ut_session"). Wer dort angemeldet ist, kommt hier ohne
# zweite Anmeldung rein – vorausgesetzt, die Cookies sind über die Hostnamen
# hinweg gültig (siehe SESSION_COOKIE_DOMAIN / *.localhost in docs/deployment.md).
# ---------------------------------------------------------------------------

{$SITE_TRACCAR:traccar.localhost} {
	tls {$TLS_ARG:internal}
	encode zstd gzip
	import ut_unavailable_page
	# Auto-Login zuerst: die Bridge meldet sich mit dem Einmal-Ticket (oder dem
	# Sitzungscookie) serverseitig an und setzt das Traccar-Sitzungscookie.
	# SSO über die Wurzel-URL: https://<traccar-host>/?sso=<ticket> → Bridge.
	# Die Wurzel ist Traccars echte SPA-Route – so kann der Browser keine alte
	# Seite für einen unbekannten Pfad aus dem Cache zeigen.
	@sso query sso=*
	handle @sso {
		reverse_proxy audio-bridge:8085 {
			header_down Cache-Control "no-store"
		}
	}
	handle /_sso/* {
		reverse_proxy audio-bridge:8085 {
			# Nie cachen: die Antwort ist eine Weiterleitung mit Sitzungscookie.
			header_down Cache-Control "no-store"
		}
	}
	handle {
		reverse_proxy traccar:8082 {
			# Traccar schickt für seine Oberfläche max-age=3600,public mit. Bei einer
			# lokalen Installation ohne CDN führt das zu veralteten Oberflächen nach
			# Updates – deshalb hier auf no-cache setzen.
			header_down Cache-Control "no-cache"
		}
	}
}

{$SITE_FINDMY:findmy.localhost} {
	tls {$TLS_ARG:internal}
	encode zstd gzip
	import ut_unavailable_page
	# Einmal-Ticket einlösen: setzt das Sitzungscookie host-only und leitet auf
	# die Wurzel weiter. Muss VOR forward_auth liegen (sonst 401, D-018).
	handle /_sso/* {
		reverse_proxy audio-bridge:8085 {
			header_down Cache-Control "no-store"
		}
	}
	handle {
		forward_auth audio-bridge:8085 {
			uri /api/v1/auth/verify
			# WebSocket-Upgrade NICHT an die Prüf-URL weiterreichen: sonst schickt
			# Caddy eine WebSocket-Anfrage an /api/v1/auth/verify, die Bridge
			# antwortet 403 und noVNC bekommt „keine Verbindung" (caddy#5430).
			# Betrifft nur die Kopie für die Prüfung – das reverse_proxy unten
			# sieht weiterhin die unveränderte Anfrage.
			header_up -Connection
		}
		reverse_proxy google-findmy-webui:4321
	}
}

{$SITE_APPLE:apple.localhost} {
	tls {$TLS_ARG:internal}
	encode zstd gzip
	import ut_unavailable_page
	handle /_sso/* {
		reverse_proxy audio-bridge:8085 {
			header_down Cache-Control "no-store"
		}
	}
	handle {
		forward_auth audio-bridge:8085 {
			uri /api/v1/auth/verify
			# siehe findmy-Block (WebSocket-Upgrade, caddy#5430)
			header_up -Connection
		}
		reverse_proxy macless-haystack:6176
	}
}

# ---------------------------------------------------------------------------
# LAN-/Schnellzugriff: nackter Hostname oder IP-Adresse (z. B. https://192.168.1.50/)
# landet direkt in der Eltern-UI – dem Einstiegspunkt.
# In server/.env setzen:  SITE_LAN=192.168.1.50   (oder der Rechnername)
# Ohne Eintrag bedient der Block nur "localhost".
# ---------------------------------------------------------------------------
{$SITE_LAN:localhost} localhost {
	tls {$TLS_ARG:internal}
	encode zstd gzip
	reverse_proxy audio-bridge:8085
}
